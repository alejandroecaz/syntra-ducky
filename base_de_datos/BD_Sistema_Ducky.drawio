ap;html=1;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="ser-255"><mxGeometry x="0" y="0" width="44" height="26" as="geometry"><mxRectangle width="44" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ser-257" value="cantidad" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="ser-255"><mxGeometry x="44" y="0" width="186" height="26" as="geometry"><mxRectangle width="186" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ser-258" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-33" target="ser-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-259" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-36" target="ser-20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-260" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERzeroToOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-67" target="ser-4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-261" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-125" target="ser-80"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-262" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-128" target="ser-103"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-263" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-150" target="ser-113"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-264" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-153" target="ser-90"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-265" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-173" target="ser-160"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-266" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-186" target="ser-113"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-267" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERzeroToOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-189" target="ser-170"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-268" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-227" target="ser-205"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-269" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-230" target="ser-40"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-270" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-249" target="ser-221"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-271" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="ser-1" source="ser-252" target="ser-113"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ser-272" value="&lt;b&gt;Simbología&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;font-size:11px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dae8fc;border:1px solid #6c8ebf;width:26px&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;Usuarios y seguridad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#d5e8d4;border:1px solid #82b366;width:26px&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;Catálogo e inventario&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#ffe6cc;border:1px solid #d79b00;width:26px&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;Compras y bajas&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11px;margin-top:6px;line-height:1.5&quot;&gt;&lt;b&gt;PK&lt;/b&gt; llave primaria (subrayada)&lt;br&gt;&lt;b style=&quot;color:#b85450&quot;&gt;FK&lt;/b&gt; llave foránea (cursiva)&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; valor único&lt;br&gt;┼── uno y sólo uno (FK obligatoria)&lt;br&gt;o┼── cero o uno (FK opcional)&lt;br&gt;o&amp;lt; cero o muchos&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="ser-1"><mxGeometry x="60" y="380" width="230" height="260" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="snf" name="2. Normalización – Sprint 1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="snf-0" /><mxCell id="snf-1" parent="snf-0" /><mxCell id="snf-2" value="&lt;b style=&quot;font-size:24px&quot;&gt;Normalización hasta 3FN · Primera entrega (Sprint 1)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Punto de partida: las tablas del prototipo del Sprint 1 (syntra.db) y la información que capturan sus formularios (usuarios, perfiles, catálogo, ejemplares y órdenes de compra). Se aplica 1FN → 2FN → 3FN.&lt;br&gt;&lt;b&gt;Notación:&lt;/b&gt; &lt;u&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/u&gt; = llave primaria subrayada · &lt;i&gt;fk&lt;/i&gt;&lt;sup style=&quot;color:#b85450&quot;&gt;FK&lt;/sup&gt; = llave foránea · &lt;span style=&quot;color:#b85450;font-weight:bold&quot;&gt;{ }&lt;/span&gt; = grupo repetitivo · A → B = &quot;A determina a B&quot; (dependencia funcional)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="snf-1"><mxGeometry x="60" y="-110" width="1700" height="80" as="geometry" /></mxCell><mxCell id="snf-3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Forma no normalizada (FN0)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;Así se capturan hoy los datos en el prototipo.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#b85450;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="snf-1"><mxGeometry x="60" y="-10" width="1700" height="36" as="geometry" /></mxCell><mxCell id="snf-4" value="&lt;table border=&quot;1&quot; style=&quot;border-collapse:collapse;font-size:11px;margin:8px 0&quot; cellpadding=&quot;4&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th&gt;clave&lt;/th&gt;&lt;th&gt;título&lt;/th&gt;&lt;th&gt;autor&lt;/th&gt;&lt;th&gt;tema&lt;/th&gt;&lt;th&gt;editorial&lt;/th&gt;&lt;th&gt;ejemplares (código · estancia / estante / posición · estado)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LIB-013&lt;/td&gt;&lt;td&gt;Física universitaria&lt;/td&gt;&lt;td&gt;&lt;b&gt;Sears y Zemansky&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Ciencia&lt;/td&gt;&lt;td&gt;Pearson (México)&lt;/td&gt;&lt;td&gt;&lt;b&gt;EJ-0023 · Sala General / F-1 / 2 · Disponible; EJ-0024 · Sala General / F-1 / 3 · Disponible&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LIB-003&lt;/td&gt;&lt;td&gt;Ingeniería de software: un enfoque práctico&lt;/td&gt;&lt;td&gt;Roger S. Pressman&lt;/td&gt;&lt;td&gt;Ingeniería de Software&lt;/td&gt;&lt;td&gt;&lt;b&gt;McGraw-Hill&lt;/b&gt; (EUA)&lt;/td&gt;&lt;td&gt;&lt;b&gt;EJ-0006 · Sala General / C-4 / 2 · Prestado; EJ-0007 · Acervo Reservado / R-1 / 5 · Reservado; EJ-0008 · …&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;LIB-009&lt;/td&gt;&lt;td&gt;Fundamentos de bases de datos&lt;/td&gt;&lt;td&gt;Abraham Silberschatz&lt;/td&gt;&lt;td&gt;Bases de datos&lt;/td&gt;&lt;td&gt;&lt;b&gt;McGraw-Hill&lt;/b&gt; (EUA)&lt;/td&gt;&lt;td&gt;EJ-0017 · Sala General / C-6 / 1 · Disponible; EJ-0018 · …&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;line-height:1.55;font-size:12px;margin-top:6px&quot;&gt;• &lt;b&gt;LIBROS&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;clave&lt;/b&gt;&lt;/u&gt;, titulo, autor, tema, editorial, pais_editorial, anio, activo, fecha_registro, fecha_baja, &lt;span style=&quot;color:#b85450;font-weight:bold&quot;&gt;{ejemplares: codigo, estancia, estante, posicion, estado}&lt;/span&gt; )&lt;br&gt;• &lt;b&gt;USUARIOS&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;identificador&lt;/b&gt;&lt;/u&gt;, nombre, cuenta, contrasena, perfil, descripcion_perfil, &lt;span style=&quot;color:#b85450;font-weight:bold&quot;&gt;{permisos: codigo, descripcion, grupo}&lt;/span&gt;, estado )&lt;br&gt;• &lt;b&gt;ORDEN_COMPRA&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;folio&lt;/b&gt;&lt;/u&gt;, proveedor, rfc_proveedor, telefono_proveedor, fecha_requerida, justificacion, solicitante, estado, &lt;span style=&quot;color:#b85450;font-weight:bold&quot;&gt;{libros: clave, titulo, cantidad}&lt;/span&gt; )&lt;br&gt;&lt;/div&gt;&lt;b&gt;Problemas:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 4px 18px;padding:0&quot;&gt;&lt;li&gt;&lt;b&gt;Valores no atómicos&lt;/b&gt;: &quot;Sears y Zemansky&quot; (dos autores en un campo), nombre completo del usuario en un solo campo, &quot;Pearson (México)&quot;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Grupos repetitivos&lt;/b&gt;: ejemplares de cada libro, permisos de cada perfil y libros de cada orden de compra.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Redundancia&lt;/b&gt;: &quot;McGraw-Hill&quot;, el tema, la estancia de cada estante y los datos del proveedor se repiten en muchas filas.&lt;/li&gt;&lt;/ul&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#fdf0ef;strokeColor=#b85450;fontSize=12;" vertex="1" parent="snf-1"><mxGeometry x="60" y="26" width="1700" height="324" as="geometry" /></mxCell><mxCell id="snf-5" value="&lt;b style=&quot;font-size:16px&quot;&gt;Primera Forma Normal (1FN)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;Valores atómicos, sin grupos repetitivos y con llave primaria.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#d79b00;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="snf-1"><mxGeometry x="60" y="380" width="1700" height="36" as="geometry" /></mxCell><mxCell id="snf-6" value="Se dividen los campos compuestos y cada grupo repetitivo se vuelve una relación con la llave de origen:&lt;div style=&quot;line-height:1.55;font-size:12px;margin-top:6px&quot;&gt;• &lt;b&gt;LIBRO_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;clave&lt;/b&gt;&lt;/u&gt;, titulo, tema, editorial, pais_editorial, anio, activo, fecha_registro, fecha_baja )&lt;br&gt;• &lt;b&gt;LIBRO_AUTOR_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;clave_libro&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;nombre_autor&lt;/b&gt;&lt;/u&gt;, apellidos_autor, nacionalidad, orden )&lt;br&gt;• &lt;b&gt;EJEMPLAR_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;codigo&lt;/b&gt;&lt;/u&gt;, clave_libro, estancia, estante, posicion, estado )&lt;br&gt;• &lt;b&gt;USUARIO_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;identificador&lt;/b&gt;&lt;/u&gt;, nombre, apellido_paterno, apellido_materno, cuenta, contrasena, perfil, descripcion_perfil, perfil_disponible, estado )&lt;br&gt;• &lt;b&gt;PERFIL_PERMISO_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;perfil&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;codigo_permiso&lt;/b&gt;&lt;/u&gt;, descripcion_permiso, grupo )&lt;br&gt;• &lt;b&gt;ORDEN_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;folio&lt;/b&gt;&lt;/u&gt;, proveedor, rfc_proveedor, telefono_proveedor, fecha_requerida, justificacion, identificador_solicitante, estado )&lt;br&gt;• &lt;b&gt;ORDEN_ITEM_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;folio&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;clave_libro&lt;/b&gt;&lt;/u&gt;, titulo, cantidad )&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#fff7ec;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="snf-1"><mxGeometry x="60" y="416" width="1700" height="179" as="geometry" /></mxCell><mxCell id="snf-7" value="&lt;b style=&quot;font-size:16px&quot;&gt;Segunda Forma Normal (2FN)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;Está en 1FN y los atributos no clave dependen de toda la llave (sin dependencias parciales).&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#6c8ebf;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="snf-1"><mxGeometry x="60" y="625" width="1700" height="36" as="geometry" /></mxCell><mxCell id="snf-8" value="&lt;b&gt;Dependencias parciales encontradas:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 4px 18px;padding:0&quot;&gt;&lt;li&gt;PERFIL_PERMISO_1FN: &lt;b&gt;codigo_permiso → descripcion_permiso, grupo&lt;/b&gt;  ⇒ se crea PERMISO.&lt;/li&gt;&lt;li&gt;LIBRO_AUTOR_1FN: &lt;b&gt;nombre_autor → apellidos_autor, nacionalidad&lt;/b&gt;  ⇒ se crea AUTOR.&lt;/li&gt;&lt;li&gt;ORDEN_ITEM_1FN: &lt;b&gt;clave_libro → titulo&lt;/b&gt;  ⇒ se elimina titulo (ya está en LIBRO).&lt;/li&gt;&lt;li&gt;LIBRO_1FN, EJEMPLAR_1FN, USUARIO_1FN y ORDEN_1FN tienen llave simple, ya cumplen 2FN.&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;line-height:1.55;font-size:12px;margin-top:6px&quot;&gt;• &lt;b&gt;PERMISO&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;codigo_permiso&lt;/b&gt;&lt;/u&gt;, descripcion, grupo )&lt;br&gt;• &lt;b&gt;PERFIL_PERMISO&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;perfil&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;&lt;i&gt;codigo_permiso&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt; )&lt;br&gt;• &lt;b&gt;AUTOR&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_autor&lt;/b&gt;&lt;/u&gt;, nombre, apellidos, nacionalidad )&lt;br&gt;• &lt;b&gt;LIBRO_AUTOR&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;&lt;i&gt;clave_libro&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;&lt;i&gt;id_autor&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt;, orden )&lt;br&gt;• &lt;b&gt;ORDEN_ITEM&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;&lt;i&gt;folio&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;&lt;i&gt;clave_libro&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt;, cantidad )&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#eef4fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="snf-1"><mxGeometry x="60" y="661" width="1700" height="212" as="geometry" /></mxCell><mxCell id="snf-9" value="&lt;b style=&quot;font-size:16px&quot;&gt;Tercera Forma Normal (3FN)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;Está en 2FN y no hay dependencias transitivas entre atributos no clave.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#82b366;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="snf-1"><mxGeometry x="60" y="903" width="1700" height="36" as="geometry" /></mxCell><mxCell id="snf-10" value="&lt;b&gt;Dependencias transitivas encontradas:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 4px 18px;padding:0&quot;&gt;&lt;li&gt;LIBRO: clave → editorial → pais_editorial  ⇒ &lt;b&gt;editoriales&lt;/b&gt;;  clave → tema  ⇒ &lt;b&gt;temas&lt;/b&gt; (catálogo de temas para los filtros de búsqueda).&lt;/li&gt;&lt;li&gt;EJEMPLAR: codigo → estante → estancia (el estante F-1 siempre está en la Sala General)  ⇒ &lt;b&gt;estantes&lt;/b&gt; y &lt;b&gt;estancias&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;USUARIO: identificador → perfil → descripcion_perfil, perfil_disponible  ⇒ &lt;b&gt;perfiles&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;ORDEN: folio → proveedor → rfc, telefono  ⇒ &lt;b&gt;proveedores&lt;/b&gt;;  identificador_solicitante se cambia por FK a &lt;b&gt;usuarios&lt;/b&gt;.&lt;/li&gt;&lt;li&gt;No se guarda el número de copias ni los disponibles: se calculan contando &lt;b&gt;ejemplares&lt;/b&gt; por estado.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Resultado final en 3FN (15 tablas)&lt;/b&gt; — se usa una llave sustituta &lt;b&gt;id&lt;/b&gt; en cada tabla y las llaves naturales (clave, codigo, folio, identificador, cuenta) quedan como UNIQUE:&lt;div style=&quot;line-height:1.55;font-size:12px;margin-top:6px&quot;&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:1px 6px&quot;&gt;&lt;b&gt;Usuarios y seguridad&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;• &lt;b&gt;perfiles&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, descripcion, disponible, fecha_registro )&lt;br&gt;• &lt;b&gt;permisos&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, codigo, descripcion, grupo )&lt;br&gt;• &lt;b&gt;perfil_permisos&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;&lt;i&gt;perfil_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;&lt;i&gt;permiso_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt; )&lt;br&gt;• &lt;b&gt;usuarios&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, identificador, nombre, apellido_paterno, apellido_materno, cuenta, email, telefono, contrasena, &lt;i&gt;perfil_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, estado, fecha_registro, fecha_actualizacion )&lt;br&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:1px 6px&quot;&gt;&lt;b&gt;Catálogo e inventario&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;• &lt;b&gt;editoriales&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, pais )&lt;br&gt;• &lt;b&gt;autores&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, apellidos, nacionalidad )&lt;br&gt;• &lt;b&gt;temas&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, descripcion )&lt;br&gt;• &lt;b&gt;libros&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, clave, isbn, titulo, &lt;i&gt;editorial_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;tema_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, anio, edicion, sinopsis, activo, fecha_registro, fecha_baja )&lt;br&gt;• &lt;b&gt;libro_autores&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;&lt;i&gt;libro_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;&lt;i&gt;autor_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt;, orden )&lt;br&gt;• &lt;b&gt;estancias&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, descripcion )&lt;br&gt;• &lt;b&gt;estantes&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;estancia_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, clave )&lt;br&gt;• &lt;b&gt;ejemplares&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, codigo, &lt;i&gt;libro_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;estante_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, posicion, estado, fecha_alta, fecha_actualizacion )&lt;br&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:1px 6px&quot;&gt;&lt;b&gt;Compras y bajas&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;• &lt;b&gt;proveedores&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, rfc, telefono, email )&lt;br&gt;• &lt;b&gt;ordenes_compra&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, folio, &lt;i&gt;proveedor_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;usuario_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, fecha_requerida, justificacion, estado, fecha_registro )&lt;br&gt;• &lt;b&gt;orden_items&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;orden_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;libro_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, cantidad )&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#f1f8ef;strokeColor=#82b366;fontSize=12;" vertex="1" parent="snf-1"><mxGeometry x="60" y="939" width="1700" height="443" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="stb" name="3. Tablas PK/FK – Sprint 1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="stb-0" /><mxCell id="stb-1" parent="stb-0" /><mxCell id="stb-2" value="&lt;b style=&quot;font-size:24px&quot;&gt;Creación de tablas: llaves y atributos · Primera entrega (Sprint 1)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Cada tabla con sus atributos, tipo de dato (MySQL 8), llaves (PK / FK) y restricciones. Todas en 3FN, motor InnoDB, juego de caracteres utf8mb4.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="stb-1"><mxGeometry x="60" y="-110" width="1800" height="70" as="geometry" /></mxCell><mxCell id="stb-3" value="&lt;b&gt;Cambios respecto al prototipo actual (syntra.db)&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 4px 18px;padding:0&quot;&gt;&lt;li&gt;libros.autor (texto) → tablas &lt;b&gt;autores&lt;/b&gt; + &lt;b&gt;libro_autores&lt;/b&gt; (un libro puede tener varios autores).&lt;/li&gt;&lt;li&gt;libros.tema y libros.editorial (texto) → &lt;b&gt;temas&lt;/b&gt; y &lt;b&gt;editoriales&lt;/b&gt; con FK.&lt;/li&gt;&lt;li&gt;ejemplares.estancia / estante (texto) → &lt;b&gt;estancias&lt;/b&gt; + &lt;b&gt;estantes&lt;/b&gt;; el ejemplar guarda estante_id y posicion (NULL = ubicación pendiente).&lt;/li&gt;&lt;li&gt;perfil_permisos.permiso (texto) → tabla &lt;b&gt;permisos&lt;/b&gt; y FK permiso_id.&lt;/li&gt;&lt;li&gt;ordenes_compra.proveedor (texto) → tabla &lt;b&gt;proveedores&lt;/b&gt; con FK.&lt;/li&gt;&lt;li&gt;usuarios.nombre → nombre, apellido_paterno, apellido_materno; se agregan email y teléfono.&lt;/li&gt;&lt;li&gt;Estados como ENUM y banderas como BOOLEAN (MySQL).&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="stb-1"><mxGeometry x="60" y="0" width="700" height="205" as="geometry" /></mxCell><mxCell id="stb-4" value="perfiles  &lt;span style=&quot;font-weight:normal;font-size:10px&quot;&gt;— Perfiles de usuario (Administrador, Bibliotecario, Profesor, Alumno...)&lt;/span&gt;" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="stb-1"><mxGeometry x="810" y="0" width="700" height="186" as="geometry"