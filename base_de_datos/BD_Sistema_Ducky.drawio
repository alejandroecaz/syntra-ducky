=10;startSize=10;" edge="1" parent="cer-1" source="cer-296" target="cer-125"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-500" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToOne;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-315" target="cer-195"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-501" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-318" target="cer-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-502" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-334" target="cer-195"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-503" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-337" target="cer-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-504" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-340" target="cer-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-505" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-356" target="cer-331"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-506" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToOne;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-375" target="cer-331"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-507" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-378" target="cer-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-508" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-394" target="cer-331"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-509" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-410" target="cer-125"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-510" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-413" target="cer-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-511" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-426" target="cer-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-512" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERzeroToOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-429" target="cer-331"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-513" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-448" target="cer-331"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-514" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-467" target="cer-445"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-515" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;jumpStyle=arc;jumpSize=8;endSize=10;startSize=10;" edge="1" parent="cer-1" source="cer-470" target="cer-52"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="cer-516" value="&lt;b&gt;Simbología&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;font-size:11px;margin-top:4px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dae8fc;border:1px solid #6c8ebf;width:26px&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;Usuarios y seguridad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#d5e8d4;border:1px solid #82b366;width:26px&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;Catálogo e inventario&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#ffe6cc;border:1px solid #d79b00;width:26px&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;Compras y bajas&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#e1d5e7;border:1px solid #9673a6;width:26px&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;Préstamos y devoluciones&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;background:#f8cecc;border:1px solid #b85450;width:26px&quot;&gt;&lt;/td&gt;&lt;td&gt;&amp;nbsp;Multas y pagos&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:11px;margin-top:6px;line-height:1.5&quot;&gt;&lt;b&gt;PK&lt;/b&gt; llave primaria (subrayada)&lt;br&gt;&lt;b style=&quot;color:#b85450&quot;&gt;FK&lt;/b&gt; llave foránea (cursiva)&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; valor único&lt;br&gt;┼── uno y sólo uno (FK obligatoria)&lt;br&gt;o┼── cero o uno (FK opcional)&lt;br&gt;o&amp;lt; cero o muchos&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="cer-1"><mxGeometry x="60" y="400" width="230" height="300" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="cnf" name="2. Normalización – Completa"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="cnf-0" /><mxCell id="cnf-1" parent="cnf-0" /><mxCell id="cnf-2" value="&lt;b style=&quot;font-size:24px&quot;&gt;Normalización hasta 3FN · Base de datos completa (Sprints 1–4)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Punto de partida: el registro manual que hoy lleva la biblioteca, donde cada préstamo se anota en una sola hoja con los datos del usuario, del libro, del ejemplar, las renovaciones, la devolución, las multas y sus pagos. A partir de ahí se aplica 1FN → 2FN → 3FN.&lt;br&gt;&lt;b&gt;Notación:&lt;/b&gt; &lt;u&gt;&lt;b&gt;PK&lt;/b&gt;&lt;/u&gt; = llave primaria subrayada · &lt;i&gt;fk&lt;/i&gt;&lt;sup style=&quot;color:#b85450&quot;&gt;FK&lt;/sup&gt; = llave foránea · &lt;span style=&quot;color:#b85450;font-weight:bold&quot;&gt;{ }&lt;/span&gt; = grupo repetitivo · A → B = &quot;A determina a B&quot; (dependencia funcional)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="cnf-1"><mxGeometry x="60" y="-110" width="1700" height="80" as="geometry" /></mxCell><mxCell id="cnf-3" value="&lt;b style=&quot;font-size:16px&quot;&gt;Forma no normalizada (FN0)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;Registro manual de préstamos, una fila por préstamo.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#b85450;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="cnf-1"><mxGeometry x="60" y="-10" width="1700" height="36" as="geometry" /></mxCell><mxCell id="cnf-4" value="Relación inicial con todos los datos que se anotan hoy:&lt;table border=&quot;1&quot; style=&quot;border-collapse:collapse;font-size:11px;margin:8px 0&quot; cellpadding=&quot;4&quot;&gt;&lt;tr style=&quot;background:#eeeeee&quot;&gt;&lt;th&gt;folio&lt;/th&gt;&lt;th&gt;usuario&lt;/th&gt;&lt;th&gt;perfil&lt;/th&gt;&lt;th&gt;libro&lt;/th&gt;&lt;th&gt;autores&lt;/th&gt;&lt;th&gt;editorial&lt;/th&gt;&lt;th&gt;ejemplar · ubicación&lt;/th&gt;&lt;th&gt;préstamo / vence&lt;/th&gt;&lt;th&gt;renovaciones&lt;/th&gt;&lt;th&gt;devolución&lt;/th&gt;&lt;th&gt;multas y pagos&lt;/th&gt;&lt;th&gt;bibliotecario&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;P-0001&lt;/td&gt;&lt;td&gt;600101 Mariana López Hernández&lt;/td&gt;&lt;td&gt;Alumno&lt;/td&gt;&lt;td&gt;LIB-013 Física universitaria&lt;/td&gt;&lt;td&gt;&lt;b&gt;Sears, Zemansky&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Pearson (México)&lt;/td&gt;&lt;td&gt;EJ-0023 · &lt;b&gt;Sala General / F-1 / 2&lt;/b&gt;&lt;/td&gt;&lt;td&gt;05/10/26 → 12/10/26&lt;/td&gt;&lt;td&gt;&lt;b&gt;1: 12/10 → 19/10&lt;/b&gt;&lt;/td&gt;&lt;td&gt;21/10/26 · Dañado&lt;/td&gt;&lt;td&gt;&lt;b&gt;Retraso $40 (Pendiente); Daño $150 (Pagada 22/10, $150, efectivo)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;N10234 Roberto Treviño&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;P-0002&lt;/td&gt;&lt;td&gt;600102 José López Martínez&lt;/td&gt;&lt;td&gt;Alumno&lt;/td&gt;&lt;td&gt;LIB-010 Introducción a los algoritmos&lt;/td&gt;&lt;td&gt;&lt;b&gt;Cormen, Leiserson, Rivest, Stein&lt;/b&gt;&lt;/td&gt;&lt;td&gt;MIT Press (EUA)&lt;/td&gt;&lt;td&gt;EJ-0019 · Sala General / C-5 / 6&lt;/td&gt;&lt;td&gt;08/10/26 → 15/10/26&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;N10234 Roberto Treviño&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;P-0003&lt;/td&gt;&lt;td&gt;N20456 Ana Lucía Robles Cantú&lt;/td&gt;&lt;td&gt;Profesor&lt;/td&gt;&lt;td&gt;LIB-003 Ingeniería de software&lt;/td&gt;&lt;td&gt;Pressman&lt;/td&gt;&lt;td&gt;McGraw-Hill (EUA)&lt;/td&gt;&lt;td&gt;EJ-0006 · Sala General / C-4 / 2&lt;/td&gt;&lt;td&gt;01/10/26 → 15/10/26&lt;/td&gt;&lt;td&gt;&lt;b&gt;1: 15/10 → 29/10; 2: 29/10 → 12/11&lt;/b&gt;&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;N10234 Roberto Treviño&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;line-height:1.55;font-size:12px;margin-top:6px&quot;&gt;• &lt;b&gt;REGISTRO_PRESTAMO&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;folio_prestamo&lt;/b&gt;&lt;/u&gt;, identificador_usuario, nombre_usuario, cuenta, perfil, &lt;span style=&quot;color:#b85450;font-weight:bold&quot;&gt;{permisos}&lt;/span&gt;, max_prestamos, dias_prestamo, max_renovaciones, multa_diaria, clave_libro, isbn, titulo, &lt;span style=&quot;color:#b85450;font-weight:bold&quot;&gt;{autores, nacionalidad}&lt;/span&gt;, tema, editorial (país), &lt;span style=&quot;color:#b85450;font-weight:bold&quot;&gt;{precios: fecha, precio, moneda}&lt;/span&gt;, codigo_ejemplar, ubicacion, estado_ejemplar, fecha_prestamo, fecha_vencimiento, &lt;span style=&quot;color:#b85450;font-weight:bold&quot;&gt;{renovaciones: número, fecha, vencimiento nuevo}&lt;/span&gt;, fecha_devolucion, condicion, &lt;span style=&quot;color:#b85450;font-weight:bold&quot;&gt;{multas: motivo, monto, estado, {pagos: fecha, monto, método}}&lt;/span&gt;, bibliotecario )&lt;br&gt;&lt;/div&gt;&lt;b&gt;Problemas:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 4px 18px;padding:0&quot;&gt;&lt;li&gt;&lt;b&gt;Grupos repetitivos&lt;/b&gt;: permisos, autores, precios, renovaciones, multas y pagos (una celda guarda varias filas).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Valores no atómicos&lt;/b&gt;: nombre completo en un campo, ubicación &quot;Sala / Estante / Posición&quot;, &quot;Pearson (México)&quot;.&lt;/li&gt;&lt;li&gt;&lt;b&gt;Redundancia&lt;/b&gt;: los datos del usuario, del perfil y del libro se repiten en cada préstamo → anomalías de inserción (no se puede dar de alta un libro sin prestarlo), actualización (cambiar una editorial en muchas filas) y borrado (al borrar el único préstamo se pierden los datos del libro).&lt;/li&gt;&lt;/ul&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#fdf0ef;strokeColor=#b85450;fontSize=12;" vertex="1" parent="cnf-1"><mxGeometry x="60" y="26" width="1700" height="341" as="geometry" /></mxCell><mxCell id="cnf-5" value="&lt;b style=&quot;font-size:16px&quot;&gt;Primera Forma Normal (1FN)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;Todos los valores son atómicos y no existen grupos repetitivos; cada relación tiene llave primaria.&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#d79b00;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="cnf-1"><mxGeometry x="60" y="397" width="1700" height="36" as="geometry" /></mxCell><mxCell id="cnf-6" value="Se separan los valores compuestos (nombre → nombre + apellidos; ubicación → estancia, estante, posición; editorial → editorial + país) y cada grupo repetitivo pasa a su propia relación llevándose la llave de origen:&lt;div style=&quot;line-height:1.55;font-size:12px;margin-top:6px&quot;&gt;• &lt;b&gt;PRESTAMO_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;folio_prestamo&lt;/b&gt;&lt;/u&gt;, identificador_usuario, nombre, apellido_paterno, apellido_materno, cuenta, perfil, max_prestamos, dias_prestamo, max_renovaciones, multa_diaria, clave_libro, isbn, titulo, tema, editorial, pais_editorial, codigo_ejemplar, estancia, estante, posicion, estado_ejemplar, fecha_prestamo, fecha_vencimiento, fecha_devolucion, condicion, id_bibliotecario, nombre_bibliotecario )&lt;br&gt;• &lt;b&gt;PERFIL_PERMISO_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;perfil&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;codigo_permiso&lt;/b&gt;&lt;/u&gt;, descripcion_permiso, grupo )&lt;br&gt;• &lt;b&gt;LIBRO_AUTOR_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;clave_libro&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;nombre_autor&lt;/b&gt;&lt;/u&gt;, apellidos_autor, nacionalidad, orden )&lt;br&gt;• &lt;b&gt;PRECIO_LIBRO_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;clave_libro&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;fecha_registro&lt;/b&gt;&lt;/u&gt;, precio, moneda )&lt;br&gt;• &lt;b&gt;RENOVACION_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;folio_prestamo&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;numero&lt;/b&gt;&lt;/u&gt;, fecha_renovacion, vencimiento_anterior, vencimiento_nuevo )&lt;br&gt;• &lt;b&gt;MULTA_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;folio_prestamo&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;motivo&lt;/b&gt;&lt;/u&gt;, monto, fecha_generacion, estado_multa )&lt;br&gt;• &lt;b&gt;PAGO_1FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;folio_prestamo&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;motivo&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;fecha_pago&lt;/b&gt;&lt;/u&gt;, monto_pago, metodo, id_bibliotecario )&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#fff7ec;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="cnf-1"><mxGeometry x="60" y="433" width="1700" height="212" as="geometry" /></mxCell><mxCell id="cnf-7" value="&lt;b style=&quot;font-size:16px&quot;&gt;Segunda Forma Normal (2FN)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;Está en 1FN y cada atributo no clave depende de TODA la llave primaria (sin dependencias parciales).&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#6c8ebf;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="cnf-1"><mxGeometry x="60" y="675" width="1700" height="36" as="geometry" /></mxCell><mxCell id="cnf-8" value="&lt;b&gt;Dependencias parciales encontradas&lt;/b&gt; (sólo pueden existir en llaves compuestas):&lt;ul style=&quot;margin:4px 0 4px 18px;padding:0&quot;&gt;&lt;li&gt;En PERFIL_PERMISO_1FN: &lt;b&gt;codigo_permiso → descripcion_permiso, grupo&lt;/b&gt; (no depende del perfil).&lt;/li&gt;&lt;li&gt;En LIBRO_AUTOR_1FN: &lt;b&gt;nombre_autor → apellidos_autor, nacionalidad&lt;/b&gt; (no depende del libro).&lt;/li&gt;&lt;li&gt;En PAGO_1FN: los datos del pago dependen de la multa completa (folio + motivo) más la fecha → se identifica cada multa con su propia llave.&lt;/li&gt;&lt;li&gt;PRESTAMO_1FN tiene llave simple, así que ya cumple 2FN. RENOVACION, MULTA y PRECIO dependen de su llave completa.&lt;/li&gt;&lt;/ul&gt;Se separan las partes que dependían sólo de una porción de la llave:&lt;div style=&quot;line-height:1.55;font-size:12px;margin-top:6px&quot;&gt;• &lt;b&gt;PERMISO&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;codigo_permiso&lt;/b&gt;&lt;/u&gt;, descripcion, grupo )&lt;br&gt;• &lt;b&gt;PERFIL_PERMISO&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;perfil&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;&lt;i&gt;codigo_permiso&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt; )&lt;br&gt;• &lt;b&gt;AUTOR&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_autor&lt;/b&gt;&lt;/u&gt;, nombre, apellidos, nacionalidad )&lt;br&gt;• &lt;b&gt;LIBRO_AUTOR&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;clave_libro&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;&lt;i&gt;id_autor&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt;, orden )&lt;br&gt;• &lt;b&gt;PRECIO_LIBRO&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;clave_libro&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;fecha_registro&lt;/b&gt;&lt;/u&gt;, precio, moneda )&lt;br&gt;• &lt;b&gt;RENOVACION&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;folio_prestamo&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;numero&lt;/b&gt;&lt;/u&gt;, fecha_renovacion, vencimiento_anterior, vencimiento_nuevo )&lt;br&gt;• &lt;b&gt;MULTA&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_multa&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;folio_prestamo&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, motivo, monto, fecha_generacion, estado )&lt;br&gt;• &lt;b&gt;PAGO_MULTA&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id_pago&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;id_multa&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, fecha_pago, monto, metodo, id_bibliotecario )&lt;br&gt;• &lt;b&gt;PRESTAMO_2FN&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;folio_prestamo&lt;/b&gt;&lt;/u&gt;, … mismos atributos que PRESTAMO_1FN … )&lt;br&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#eef4fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="cnf-1"><mxGeometry x="60" y="711" width="1700" height="278" as="geometry" /></mxCell><mxCell id="cnf-9" value="&lt;b style=&quot;font-size:16px&quot;&gt;Tercera Forma Normal (3FN)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;Está en 2FN y ningún atributo no clave depende de otro atributo no clave (sin dependencias transitivas).&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=12;fillColor=#82b366;fontColor=#ffffff;strokeColor=none;" vertex="1" parent="cnf-1"><mxGeometry x="60" y="1019" width="1700" height="36" as="geometry" /></mxCell><mxCell id="cnf-10" value="&lt;b&gt;Dependencias transitivas encontradas en PRESTAMO_2FN&lt;/b&gt; y su solución:&lt;ul style=&quot;margin:4px 0 4px 18px;padding:0&quot;&gt;&lt;li&gt;folio → identificador_usuario → nombre, apellidos, cuenta, perfil  ⇒ &lt;b&gt;usuarios&lt;/b&gt;&lt;/li&gt;&lt;li&gt;identificador_usuario → perfil → max_prestamos, dias_prestamo, max_renovaciones, multa_diaria  ⇒ &lt;b&gt;perfiles&lt;/b&gt; (las reglas de préstamo dependen del perfil: Alumno 2 libros / 5 días / 2 renovaciones, Profesor 10 días / 3 renovaciones)&lt;/li&gt;&lt;li&gt;folio → codigo_ejemplar → clave_libro, estante, posicion, estado_ejemplar  ⇒ &lt;b&gt;ejemplares&lt;/b&gt;&lt;/li&gt;&lt;li&gt;codigo_ejemplar → clave_libro → isbn, titulo, tema, editorial  ⇒ &lt;b&gt;libros&lt;/b&gt;&lt;/li&gt;&lt;li&gt;clave_libro → editorial → pais  ⇒ &lt;b&gt;editoriales&lt;/b&gt;;  clave_libro → tema  ⇒ &lt;b&gt;temas&lt;/b&gt;&lt;/li&gt;&lt;li&gt;codigo_ejemplar → estante → estancia (el estante C-5 siempre está en la Sala General)  ⇒ &lt;b&gt;estantes&lt;/b&gt; y &lt;b&gt;estancias&lt;/b&gt;&lt;/li&gt;&lt;li&gt;id_bibliotecario → nombre_bibliotecario  ⇒ se elimina el nombre y se referencia a &lt;b&gt;usuarios&lt;/b&gt; (bibliotecario_id)&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Decisiones de diseño:&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 4px 18px;padding:0&quot;&gt;&lt;li&gt;fecha_devolucion y condicion sólo existen cuando el libro regresa ⇒ tabla &lt;b&gt;devoluciones&lt;/b&gt; (1 : 0..1 con préstamos) para evitar nulos.&lt;/li&gt;&lt;li&gt;No se guardan datos calculables: días de retraso, saldo pendiente de una multa, número de copias o disponibles, usuario de una multa (se obtiene por el préstamo).&lt;/li&gt;&lt;li&gt;Las llaves naturales (folio, clave, código, identificador) quedan como UNIQUE y cada tabla usa una llave sustituta &lt;b&gt;id INT AUTO_INCREMENT&lt;/b&gt; como PK.&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Resultado final en 3FN (26 tablas):&lt;/b&gt;&lt;div style=&quot;line-height:1.55;font-size:12px;margin-top:6px&quot;&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf;padding:1px 6px&quot;&gt;&lt;b&gt;Usuarios y seguridad&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;• &lt;b&gt;perfiles&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, descripcion, disponible, max_prestamos, dias_prestamo, max_renovaciones, multa_diaria, fecha_registro )&lt;br&gt;• &lt;b&gt;permisos&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, codigo, descripcion, grupo )&lt;br&gt;• &lt;b&gt;perfil_permisos&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;&lt;i&gt;perfil_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;&lt;i&gt;permiso_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt; )&lt;br&gt;• &lt;b&gt;usuarios&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, identificador, nombre, apellido_paterno, apellido_materno, cuenta, email, telefono, contrasena, &lt;i&gt;perfil_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, estado, fecha_registro, fecha_actualizacion )&lt;br&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366;padding:1px 6px&quot;&gt;&lt;b&gt;Catálogo e inventario&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;• &lt;b&gt;editoriales&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, pais )&lt;br&gt;• &lt;b&gt;autores&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, apellidos, nacionalidad )&lt;br&gt;• &lt;b&gt;temas&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, descripcion )&lt;br&gt;• &lt;b&gt;libros&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, clave, isbn, titulo, &lt;i&gt;editorial_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;tema_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, anio, edicion, sinopsis, tipo_acceso, activo, fecha_registro, fecha_baja )&lt;br&gt;• &lt;b&gt;libro_autores&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;&lt;i&gt;libro_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt;, &lt;u&gt;&lt;b&gt;&lt;i&gt;autor_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;&lt;/b&gt;&lt;/u&gt;, orden )&lt;br&gt;• &lt;b&gt;estancias&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, descripcion )&lt;br&gt;• &lt;b&gt;estantes&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;estancia_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, clave )&lt;br&gt;• &lt;b&gt;ejemplares&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, codigo, &lt;i&gt;libro_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;estante_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, posicion, estado, fecha_alta, fecha_actualizacion )&lt;br&gt;• &lt;b&gt;precios_libro&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;libro_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, precio, moneda, fecha_registro )&lt;br&gt;• &lt;b&gt;tipos_cambio&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, moneda, fecha, valor_mxn ) &lt;span style=&quot;color:#d79b00;font-size:11px&quot;&gt;← pérdida con precio en dólares&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;&lt;span style=&quot;background:#ffe6cc;border:1px solid #d79b00;padding:1px 6px&quot;&gt;&lt;b&gt;Compras y bajas&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;• &lt;b&gt;proveedores&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, nombre, rfc, telefono, email ) &lt;span style=&quot;color:#d79b00;font-size:11px&quot;&gt;← requerimiento Sprint 3 (compras)&lt;/span&gt;&lt;br&gt;• &lt;b&gt;ordenes_compra&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, folio, &lt;i&gt;proveedor_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;usuario_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, fecha_requerida, justificacion, estado, fecha_registro ) &lt;span style=&quot;color:#d79b00;font-size:11px&quot;&gt;← requerimiento HU-01-18&lt;/span&gt;&lt;br&gt;• &lt;b&gt;orden_items&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;orden_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;libro_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, cantidad, precio_unitario, moneda, cantidad_recibida ) &lt;span style=&quot;color:#d79b00;font-size:11px&quot;&gt;← renglones de la orden&lt;/span&gt;&lt;br&gt;• &lt;b&gt;bajas_ejemplar&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;ejemplar_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;usuario_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, motivo, fecha_baja, observaciones ) &lt;span style=&quot;color:#d79b00;font-size:11px&quot;&gt;← requerimiento Sprint 3 (bajas)&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;&lt;span style=&quot;background:#e1d5e7;border:1px solid #9673a6;padding:1px 6px&quot;&gt;&lt;b&gt;Préstamos y devoluciones&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;• &lt;b&gt;prestamos&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;ejemplar_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;usuario_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;bibliotecario_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, fecha_prestamo, fecha_vencimiento, estado )&lt;br&gt;• &lt;b&gt;renovaciones&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;prestamo_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, numero, fecha_renovacion, vencimiento_anterior, vencimiento_nuevo )&lt;br&gt;• &lt;b&gt;devoluciones&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;prestamo_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;bibliotecario_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, fecha_devolucion, condicion, observaciones )&lt;br&gt;• &lt;b&gt;comprobantes_prestamo&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;prestamo_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, medio, destino, fecha_emision ) &lt;span style=&quot;color:#d79b00;font-size:11px&quot;&gt;← recibo por email / WhatsApp / impresión&lt;/span&gt;&lt;br&gt;• &lt;b&gt;lista_espera&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;libro_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;usuario_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, fecha_solicitud, estado ) &lt;span style=&quot;color:#d79b00;font-size:11px&quot;&gt;← requerimiento Sprint 2&lt;/span&gt;&lt;br&gt;• &lt;b&gt;avisos&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;usuario_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;prestamo_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, tipo, medio, mensaje, fecha_envio ) &lt;span style=&quot;color:#d79b00;font-size:11px&quot;&gt;← avisos de vencimiento y adeudo&lt;/span&gt;&lt;br&gt;&lt;div style=&quot;margin-top:6px&quot;&gt;&lt;span style=&quot;background:#f8cecc;border:1px solid #b85450;padding:1px 6px&quot;&gt;&lt;b&gt;Multas y pagos&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;• &lt;b&gt;multas&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;prestamo_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, motivo, monto, fecha_generacion, estado )&lt;br&gt;• &lt;b&gt;pagos_multa&lt;/b&gt; ( &lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt;, &lt;i&gt;multa_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, &lt;i&gt;bibliotecario_id&lt;/i&gt;&lt;sup style=&quot;color:#b85450;font-size:8px&quot;&gt;FK&lt;/sup&gt;, monto, metodo, referencia, fecha_pago )&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;margin-top:8px;color:#555&quot;&gt;Las tablas marcadas con ← se agregan por los requerimientos de los Sprints 2–4; se diseñaron directamente en 3FN: cada una tiene llave simple y sus atributos describen sólo a esa entidad (por ejemplo, orden_items no guarda el título del libro porque dependería sólo de libro_id).&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#f1f8ef;strokeColor=#82b366;fontSize=12;" vertex="1" parent="cnf-1"><mxGeometry x="60" y="1055" width="1700" height="775" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ctb" name="3. Tablas PK/FK – Completa"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="ctb-0" /><mxCell id="ctb-1" parent="ctb-0" /><mxCell id="ctb-2" value="&lt;b style=&quot;font-size:24px&quot;&gt;Creación de tablas: llaves y atributos · Base de datos completa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Cada tabla con sus atributos, tipo de dato (MySQL 8), llaves (PK / FK) y restricciones. Todas en 3FN, motor InnoDB, juego de caracteres utf8mb4.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="ctb-1"><mxGeometry x="60" y="-110" width="1800" height="70" as="geometry" /></mxCell><mxCell id="ctb-3" value="&lt;b&gt;Notas de implementación&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 4px 18px;padding:0&quot;&gt;&lt;li&gt;Llaves foráneas con &lt;b&gt;ON UPDATE CASCADE&lt;/b&gt; y &lt;b&gt;ON DELETE RESTRICT&lt;/b&gt; (no se borra un registro con historial; la baja es lógica). Excepciones con CASCADE: perfil_permisos, libro_autores y orden_items.&lt;/li&gt;&lt;li&gt;&lt;b&gt;prestamos&lt;/b&gt; referencia dos veces a usuarios: usuario_id (quien solicita) y bibliotecario_id (quien registra).&lt;/li&gt;&lt;li&gt;&lt;b&gt;devoluciones.prestamo_id&lt;/b&gt; y &lt;b&gt;bajas_ejemplar.ejemplar_id&lt;/b&gt; son UNIQUE → relación 1 a 0..1.&lt;/li&gt;&lt;li&gt;Reglas de préstamo por perfil en &lt;b&gt;perfiles&lt;/b&gt; (max_prestamos, dias_prestamo, max_renovaciones, multa_diaria); son NULL para perfiles que no piden libros (Administrador).&lt;/li&gt;&lt;li&gt;Costo de reposición = último registro de &lt;b&gt;precios_libro&lt;/b&gt; × &lt;b&gt;tipos_cambio&lt;/b&gt; vigente si la moneda es USD.&lt;/li&gt;&lt;/ul&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="ctb-1"><mxGeometry x="60" y="0" width="700" height="189" as="geometry" /></mxCell><mxCell id="ctb-4" value="perfiles  &lt;span style=&quot;font-weight:normal;font-size:10px&quot;&gt;— Perfiles de usuario (Administrador, Bibliotecario, Profesor, Alumno...) y sus reglas de préstamo&lt;/span&gt;" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="ctb-1"><mxGeometry x="810" y="0" width="700" height="290" as="geometry" /></mxCell><mxCell id="ctb-5" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#f5f5f5;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=1;strokeColor=#cccccc;" vertex="1" parent="ctb-4"><mxGeometry x="0" y="30" width="700" height="26" as="geometry" /></mxCell><mxCell id="ctb-6" value="Atributo" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=center;fontStyle=1;fontStyle=1;" vertex="1" parent="ctb-5"><mxGeometry x="0" y="0" width="170" height="26" as="geometry"><mxRectangle width="170" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-7" value="Tipo de dato" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontStyle=1;" vertex="1" parent="ctb-5"><mxGeometry x="170" y="0" width="215" height="26" as="geometry"><mxRectangle width="215" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-8" value="Llave" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontStyle=1;" vertex="1" parent="ctb-5"><mxGeometry x="385" y="0" width="60" height="26" as="geometry"><mxRectangle width="60" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-9" value="Restricciones" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontStyle=1;" vertex="1" parent="ctb-5"><mxGeometry x="445" y="0" width="255" height="26" as="geometry"><mxRectangle width="255" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-10" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=1;strokeColor=#cccccc;" vertex="1" parent="ctb-4"><mxGeometry x="0" y="56" width="700" height="26" as="geometry" /></mxCell><mxCell id="ctb-11" value="id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=center;fontStyle=1;fontStyle=5;" vertex="1" parent="ctb-10"><mxGeometry x="0" y="0" width="170" height="26" as="geometry"><mxRectangle width="170" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-12" value="INT UNSIGNED" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="ctb-10"><mxGeometry x="170" y="0" width="215" height="26" as="geometry"><mxRectangle width="215" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-13" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontStyle=1;align=