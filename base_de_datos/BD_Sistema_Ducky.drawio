;fontSize=11;align=left;spacingLeft=6;fontStyle=1;align=center;spacingLeft=0;" vertex="1" parent="stb-475"><mxGeometry x="385" y="0" width="60" height="26" as="geometry"><mxRectangle width="60" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-479" value="AUTO_INCREMENT" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="stb-475"><mxGeometry x="445" y="0" width="255" height="26" as="geometry"><mxRectangle width="255" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-480" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=1;strokeColor=#cccccc;" vertex="1" parent="stb-469"><mxGeometry x="0" y="82" width="700" height="26" as="geometry" /></mxCell><mxCell id="stb-481" value="orden_id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=center;fontStyle=1;fontStyle=2;" vertex="1" parent="stb-480"><mxGeometry x="0" y="0" width="170" height="26" as="geometry"><mxRectangle width="170" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-482" value="INT UNSIGNED" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="stb-480"><mxGeometry x="170" y="0" width="215" height="26" as="geometry"><mxRectangle width="215" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-483" value="FK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontStyle=1;align=center;spacingLeft=0;fontColor=#b85450;" vertex="1" parent="stb-480"><mxGeometry x="385" y="0" width="60" height="26" as="geometry"><mxRectangle width="60" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-484" value="NOT NULL · → ordenes_compra(id)" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="stb-480"><mxGeometry x="445" y="0" width="255" height="26" as="geometry"><mxRectangle width="255" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-485" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=1;strokeColor=#cccccc;" vertex="1" parent="stb-469"><mxGeometry x="0" y="108" width="700" height="26" as="geometry" /></mxCell><mxCell id="stb-486" value="libro_id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=center;fontStyle=1;fontStyle=2;" vertex="1" parent="stb-485"><mxGeometry x="0" y="0" width="170" height="26" as="geometry"><mxRectangle width="170" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-487" value="INT UNSIGNED" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="stb-485"><mxGeometry x="170" y="0" width="215" height="26" as="geometry"><mxRectangle width="215" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-488" value="FK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontStyle=1;align=center;spacingLeft=0;fontColor=#b85450;" vertex="1" parent="stb-485"><mxGeometry x="385" y="0" width="60" height="26" as="geometry"><mxRectangle width="60" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-489" value="NOT NULL · → libros(id)" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="stb-485"><mxGeometry x="445" y="0" width="255" height="26" as="geometry"><mxRectangle width="255" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-490" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=#cccccc;" vertex="1" parent="stb-469"><mxGeometry x="0" y="134" width="700" height="26" as="geometry" /></mxCell><mxCell id="stb-491" value="cantidad" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="stb-490"><mxGeometry x="0" y="0" width="170" height="26" as="geometry"><mxRectangle width="170" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-492" value="SMALLINT UNSIGNED" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="stb-490"><mxGeometry x="170" y="0" width="215" height="26" as="geometry"><mxRectangle width="215" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-493" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontStyle=1;align=center;spacingLeft=0;" vertex="1" parent="stb-490"><mxGeometry x="385" y="0" width="60" height="26" as="geometry"><mxRectangle width="60" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-494" value="NOT NULL" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="stb-490"><mxGeometry x="445" y="0" width="255" height="26" as="geometry"><mxRectangle width="255" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="stb-495" value="&lt;b&gt;Restricciones de tabla:&lt;/b&gt; UNIQUE (orden_id, libro_id) · CHECK (cantidad &amp;gt; 0)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=4;fontColor=#333333;" vertex="1" parent="stb-1"><mxGeometry x="810" y="1290" width="700" height="22" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ssq" name="4. Script SQL – Sprint 1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="ssq-0" /><mxCell id="ssq-1" parent="ssq-0" /><mxCell id="ssq-2" value="&lt;b style=&quot;font-size:24px&quot;&gt;Script SQL (MySQL) · Primera entrega (Sprint 1)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Script de creación de tablas para MySQL 8 (también disponible como archivo .sql). Se crean primero las tablas sin dependencias y después las que tienen llaves foráneas.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="ssq-1"><mxGeometry x="60" y="-110" width="1800" height="70" as="geometry" /></mxCell><mxCell id="ssq-3" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:10px;line-height:12px&quot;&gt;-- ============================================================&#10;-- Sistema Ducky de Gestión Bibliotecaria - Syntra Technologies (Equipo 1)&#10;-- Base de datos PRIMERA ENTREGA (Sprint 1) - MySQL 8&#10;-- ============================================================&#10;DROP DATABASE IF EXISTS ducky_biblioteca_sprint1;&#10;CREATE DATABASE ducky_biblioteca_sprint1 CHARACTER SET utf8mb4 COLLATE utf8mb4_spanish_ci;&#10;USE ducky_biblioteca_sprint1;&#10;&#10;-- Perfiles de usuario (Administrador, Bibliotecario, Profesor, Alumno...)&#10;CREATE TABLE perfiles (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(60) NOT NULL UNIQUE,&#10;    descripcion            VARCHAR(255),&#10;    disponible             BOOLEAN NOT NULL DEFAULT TRUE,&#10;    fecha_registro         DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    CONSTRAINT pk_perfiles PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Catálogo de permisos del sistema (ej. libros.alta)&#10;CREATE TABLE permisos (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    codigo                 VARCHAR(60) NOT NULL UNIQUE,&#10;    descripcion            VARCHAR(150) NOT NULL,&#10;    grupo                  VARCHAR(40) NOT NULL,&#10;    CONSTRAINT pk_permisos PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Relación N:M entre perfiles y permisos&#10;CREATE TABLE perfil_permisos (&#10;    perfil_id              INT UNSIGNED NOT NULL,&#10;    permiso_id             INT UNSIGNED NOT NULL,&#10;    CONSTRAINT pk_perfil_permisos PRIMARY KEY (perfil_id, permiso_id),&#10;    CONSTRAINT fk_perfil_permisos_perfil FOREIGN KEY (perfil_id) REFERENCES perfiles(id)&#10;        ON UPDATE CASCADE ON DELETE CASCADE,&#10;    CONSTRAINT fk_perfil_permisos_permiso FOREIGN KEY (permiso_id) REFERENCES permisos(id)&#10;        ON UPDATE CASCADE ON DELETE CASCADE&#10;) ENGINE=InnoDB;&#10;&#10;-- Cuentas de alumnos, profesores y personal&#10;CREATE TABLE usuarios (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    identificador          VARCHAR(20) NOT NULL UNIQUE,&#10;    nombre                 VARCHAR(60) NOT NULL,&#10;    apellido_paterno       VARCHAR(60) NOT NULL,&#10;    apellido_materno       VARCHAR(60),&#10;    cuenta                 VARCHAR(50) NOT NULL UNIQUE,&#10;    email                  VARCHAR(150) UNIQUE,&#10;    telefono               VARCHAR(20),&#10;    contrasena             VARCHAR(255) NOT NULL,&#10;    perfil_id              INT UNSIGNED,&#10;    estado                 ENUM(&amp;#x27;Habilitada&amp;#x27;,&amp;#x27;Deshabilitada&amp;#x27;) NOT NULL DEFAULT &amp;#x27;Habilitada&amp;#x27;,&#10;    fecha_registro         DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    fecha_actualizacion    DATETIME,&#10;    CONSTRAINT pk_usuarios PRIMARY KEY (id),&#10;    CONSTRAINT fk_usuarios_perfil FOREIGN KEY (perfil_id) REFERENCES perfiles(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Editoriales de los libros&#10;CREATE TABLE editoriales (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(150) NOT NULL UNIQUE,&#10;    pais                   VARCHAR(60),&#10;    CONSTRAINT pk_editoriales PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Autores&#10;CREATE TABLE autores (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(100) NOT NULL,&#10;    apellidos              VARCHAR(100),&#10;    nacionalidad           VARCHAR(60),&#10;    CONSTRAINT pk_autores PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Temas o categorías del catálogo&#10;CREATE TABLE temas (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(120) NOT NULL UNIQUE,&#10;    descripcion            VARCHAR(255),&#10;    CONSTRAINT pk_temas PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Ficha bibliográfica de cada título&#10;CREATE TABLE libros (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    clave                  VARCHAR(20) NOT NULL UNIQUE,&#10;    isbn                   VARCHAR(20) UNIQUE,&#10;    titulo                 VARCHAR(255) NOT NULL,&#10;    editorial_id           INT UNSIGNED NOT NULL,&#10;    tema_id                INT UNSIGNED NOT NULL,&#10;    anio                   SMALLINT,&#10;    edicion                VARCHAR(30),&#10;    sinopsis               TEXT,&#10;    activo                 BOOLEAN NOT NULL DEFAULT TRUE,&#10;    fecha_registro         DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    fecha_baja             DATETIME,&#10;    CONSTRAINT pk_libros PRIMARY KEY (id),&#10;    CONSTRAINT fk_libros_editorial FOREIGN KEY (editorial_id) REFERENCES editoriales(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_libros_tema FOREIGN KEY (tema_id) REFERENCES temas(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Relación N:M entre libros y autores&#10;CREATE TABLE libro_autores (&#10;    libro_id               INT UNSIGNED NOT NULL,&#10;    autor_id               INT UNSIGNED NOT NULL,&#10;    orden                  TINYINT UNSIGNED NOT NULL DEFAULT 1,&#10;    CONSTRAINT pk_libro_autores PRIMARY KEY (libro_id, autor_id),&#10;    CONSTRAINT fk_libro_autores_libro FOREIGN KEY (libro_id) REFERENCES libros(id)&#10;        ON UPDATE CASCADE ON DELETE CASCADE,&#10;    CONSTRAINT fk_libro_autores_autor FOREIGN KEY (autor_id) REFERENCES autores(id)&#10;        ON UPDATE CASCADE ON DELETE CASCADE&#10;) ENGINE=InnoDB;&#10;&lt;/pre&gt;" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Courier New;fontSize=10;fillColor=#f7f7f7;fontColor=#1a1a1a;strokeColor=#999999;" vertex="1" parent="ssq-1"><mxGeometry x="60" y="0" width="900" height="1606" as="geometry" /></mxCell><mxCell id="ssq-4" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:10px;line-height:12px&quot;&gt;-- Salas de la biblioteca (Sala General, Hemeroteca...)&#10;CREATE TABLE estancias (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(60) NOT NULL UNIQUE,&#10;    descripcion            VARCHAR(255),&#10;    CONSTRAINT pk_estancias PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Estantes dentro de cada estancia&#10;CREATE TABLE estantes (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    estancia_id            INT UNSIGNED NOT NULL,&#10;    clave                  VARCHAR(20) NOT NULL,&#10;    CONSTRAINT pk_estantes PRIMARY KEY (id),&#10;    CONSTRAINT uq_estantes_estancia_id_clave UNIQUE (estancia_id, clave),&#10;    CONSTRAINT fk_estantes_estancia FOREIGN KEY (estancia_id) REFERENCES estancias(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Copias físicas de cada libro, con ubicación y estado&#10;CREATE TABLE ejemplares (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    codigo                 VARCHAR(20) NOT NULL UNIQUE,&#10;    libro_id               INT UNSIGNED NOT NULL,&#10;    estante_id             INT UNSIGNED,&#10;    posicion               VARCHAR(20),&#10;    estado                 ENUM(&amp;#x27;Disponible&amp;#x27;,&amp;#x27;Prestado&amp;#x27;,&amp;#x27;Reservado&amp;#x27;,&amp;#x27;Perdido&amp;#x27;,&amp;#x27;Dañado&amp;#x27;,&amp;#x27;Fuera de servicio&amp;#x27;) NOT NULL DEFAULT &amp;#x27;Disponible&amp;#x27;,&#10;    fecha_alta             DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    fecha_actualizacion    DATETIME,&#10;    CONSTRAINT pk_ejemplares PRIMARY KEY (id),&#10;    CONSTRAINT fk_ejemplares_libro FOREIGN KEY (libro_id) REFERENCES libros(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_ejemplares_estante FOREIGN KEY (estante_id) REFERENCES estantes(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Proveedores de libros&#10;CREATE TABLE proveedores (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(150) NOT NULL,&#10;    rfc                    VARCHAR(13) UNIQUE,&#10;    telefono               VARCHAR(20),&#10;    email                  VARCHAR(150),&#10;    CONSTRAINT pk_proveedores PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Órdenes de compra generadas por el bibliotecario&#10;CREATE TABLE ordenes_compra (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    folio                  VARCHAR(20) NOT NULL UNIQUE,&#10;    proveedor_id           INT UNSIGNED NOT NULL,&#10;    usuario_id             INT UNSIGNED NOT NULL,&#10;    fecha_requerida        DATE NOT NULL,&#10;    justificacion          TEXT,&#10;    estado                 ENUM(&amp;#x27;Registrada&amp;#x27;,&amp;#x27;Cancelada&amp;#x27;) NOT NULL DEFAULT &amp;#x27;Registrada&amp;#x27;,&#10;    fecha_registro         DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    CONSTRAINT pk_ordenes_compra PRIMARY KEY (id),&#10;    CONSTRAINT fk_ordenes_compra_proveedor FOREIGN KEY (proveedor_id) REFERENCES proveedores(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_ordenes_compra_usuario FOREIGN KEY (usuario_id) REFERENCES usuarios(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Renglones (libros y cantidades) de cada orden&#10;CREATE TABLE orden_items (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    orden_id               INT UNSIGNED NOT NULL,&#10;    libro_id               INT UNSIGNED NOT NULL,&#10;    cantidad               SMALLINT UNSIGNED NOT NULL,&#10;    CONSTRAINT pk_orden_items PRIMARY KEY (id),&#10;    CONSTRAINT uq_orden_items_orden_id_libro_id UNIQUE (orden_id, libro_id),&#10;    CONSTRAINT ck_orden_items_1 CHECK (cantidad &amp;gt; 0),&#10;    CONSTRAINT fk_orden_items_orden FOREIGN KEY (orden_id) REFERENCES ordenes_compra(id)&#10;        ON UPDATE CASCADE ON DELETE CASCADE,&#10;    CONSTRAINT fk_orden_items_libro FOREIGN KEY (libro_id) REFERENCES libros(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Índices para búsquedas del catálogo&#10;CREATE INDEX idx_libros_titulo ON libros (titulo);&#10;CREATE INDEX idx_autores_nombre ON autores (apellidos, nombre);&#10;CREATE INDEX idx_usuarios_nombre ON usuarios (apellido_paterno, nombre);&#10;CREATE INDEX idx_ejemplares_estado ON ejemplares (estado);&#10;&lt;/pre&gt;" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Courier New;fontSize=10;fillColor=#f7f7f7;fontColor=#1a1a1a;strokeColor=#999999;" vertex="1" parent="ssq-1"><mxGeometry x="990" y="0" width="900" height="1174" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>