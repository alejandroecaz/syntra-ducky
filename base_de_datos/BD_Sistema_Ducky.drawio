rent="ctb-885"><mxGeometry x="0" y="160" width="700" height="38" as="geometry" /></mxCell><mxCell id="ctb-912" value="metodo" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="ctb-911"><mxGeometry x="0" y="0" width="170" height="38" as="geometry"><mxRectangle width="170" height="38" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-913" value="ENUM('Efectivo', 'Tarjeta', 'Transferencia')" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="ctb-911"><mxGeometry x="170" y="0" width="215" height="38" as="geometry"><mxRectangle width="215" height="38" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-914" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontStyle=1;align=center;spacingLeft=0;" vertex="1" parent="ctb-911"><mxGeometry x="385" y="0" width="60" height="38" as="geometry"><mxRectangle width="60" height="38" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-915" value="NOT NULL" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="ctb-911"><mxGeometry x="445" y="0" width="255" height="38" as="geometry"><mxRectangle width="255" height="38" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-916" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=1;strokeColor=#cccccc;" vertex="1" parent="ctb-885"><mxGeometry x="0" y="198" width="700" height="26" as="geometry" /></mxCell><mxCell id="ctb-917" value="referencia" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="ctb-916"><mxGeometry x="0" y="0" width="170" height="26" as="geometry"><mxRectangle width="170" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-918" value="VARCHAR(50)" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="ctb-916"><mxGeometry x="170" y="0" width="215" height="26" as="geometry"><mxRectangle width="215" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-919" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontStyle=1;align=center;spacingLeft=0;" vertex="1" parent="ctb-916"><mxGeometry x="385" y="0" width="60" height="26" as="geometry"><mxRectangle width="60" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-920" value="NULL" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="ctb-916"><mxGeometry x="445" y="0" width="255" height="26" as="geometry"><mxRectangle width="255" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-921" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=#cccccc;" vertex="1" parent="ctb-885"><mxGeometry x="0" y="224" width="700" height="26" as="geometry" /></mxCell><mxCell id="ctb-922" value="fecha_pago" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="ctb-921"><mxGeometry x="0" y="0" width="170" height="26" as="geometry"><mxRectangle width="170" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-923" value="DATETIME" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="ctb-921"><mxGeometry x="170" y="0" width="215" height="26" as="geometry"><mxRectangle width="215" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-924" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontStyle=1;align=center;spacingLeft=0;" vertex="1" parent="ctb-921"><mxGeometry x="385" y="0" width="60" height="26" as="geometry"><mxRectangle width="60" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-925" value="NOT NULL · DEFAULT CURRENT_TIMESTAMP" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="ctb-921"><mxGeometry x="445" y="0" width="255" height="26" as="geometry"><mxRectangle width="255" height="26" as="alternateBounds" /></mxGeometry></mxCell><mxCell id="ctb-926" value="&lt;b&gt;Restricciones de tabla:&lt;/b&gt; CHECK (monto &amp;gt; 0)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;spacingLeft=4;fontColor=#333333;" vertex="1" parent="ctb-1"><mxGeometry x="1560" y="2296" width="700" height="22" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="csq" name="4. Script SQL – Completa"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="csq-0" /><mxCell id="csq-1" parent="csq-0" /><mxCell id="csq-2" value="&lt;b style=&quot;font-size:24px&quot;&gt;Script SQL (MySQL) · Base de datos completa&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#444&quot;&gt;Script de creación de tablas para MySQL 8 (también disponible como archivo .sql). Se crean primero las tablas sin dependencias y después las que tienen llaves foráneas.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="csq-1"><mxGeometry x="60" y="-110" width="1800" height="70" as="geometry" /></mxCell><mxCell id="csq-3" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:10px;line-height:12px&quot;&gt;-- ============================================================&#10;-- Sistema Ducky de Gestión Bibliotecaria - Syntra Technologies (Equipo 1)&#10;-- Base de datos COMPLETA (Sprints 1-4) - MySQL 8&#10;-- ============================================================&#10;DROP DATABASE IF EXISTS ducky_biblioteca;&#10;CREATE DATABASE ducky_biblioteca CHARACTER SET utf8mb4 COLLATE utf8mb4_spanish_ci;&#10;USE ducky_biblioteca;&#10;&#10;-- Perfiles de usuario (Administrador, Bibliotecario, Profesor, Alumno...) y sus reglas de préstamo&#10;CREATE TABLE perfiles (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(60) NOT NULL UNIQUE,&#10;    descripcion            VARCHAR(255),&#10;    disponible             BOOLEAN NOT NULL DEFAULT TRUE,&#10;    max_prestamos          TINYINT UNSIGNED,&#10;    dias_prestamo          TINYINT UNSIGNED,&#10;    max_renovaciones       TINYINT UNSIGNED,&#10;    multa_diaria           DECIMAL(8,2),&#10;    fecha_registro         DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    CONSTRAINT pk_perfiles PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Catálogo de permisos del sistema (ej. libros.alta)&#10;CREATE TABLE permisos (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    codigo                 VARCHAR(60) NOT NULL UNIQUE,&#10;    descripcion            VARCHAR(150) NOT NULL,&#10;    grupo                  VARCHAR(40) NOT NULL,&#10;    CONSTRAINT pk_permisos PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Relación N:M entre perfiles y permisos&#10;CREATE TABLE perfil_permisos (&#10;    perfil_id              INT UNSIGNED NOT NULL,&#10;    permiso_id             INT UNSIGNED NOT NULL,&#10;    CONSTRAINT pk_perfil_permisos PRIMARY KEY (perfil_id, permiso_id),&#10;    CONSTRAINT fk_perfil_permisos_perfil FOREIGN KEY (perfil_id) REFERENCES perfiles(id)&#10;        ON UPDATE CASCADE ON DELETE CASCADE,&#10;    CONSTRAINT fk_perfil_permisos_permiso FOREIGN KEY (permiso_id) REFERENCES permisos(id)&#10;        ON UPDATE CASCADE ON DELETE CASCADE&#10;) ENGINE=InnoDB;&#10;&#10;-- Cuentas de alumnos, profesores y personal&#10;CREATE TABLE usuarios (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    identificador          VARCHAR(20) NOT NULL UNIQUE,&#10;    nombre                 VARCHAR(60) NOT NULL,&#10;    apellido_paterno       VARCHAR(60) NOT NULL,&#10;    apellido_materno       VARCHAR(60),&#10;    cuenta                 VARCHAR(50) NOT NULL UNIQUE,&#10;    email                  VARCHAR(150) UNIQUE,&#10;    telefono               VARCHAR(20),&#10;    contrasena             VARCHAR(255) NOT NULL,&#10;    perfil_id              INT UNSIGNED,&#10;    estado                 ENUM(&amp;#x27;Habilitada&amp;#x27;,&amp;#x27;Deshabilitada&amp;#x27;) NOT NULL DEFAULT &amp;#x27;Habilitada&amp;#x27;,&#10;    fecha_registro         DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    fecha_actualizacion    DATETIME,&#10;    CONSTRAINT pk_usuarios PRIMARY KEY (id),&#10;    CONSTRAINT fk_usuarios_perfil FOREIGN KEY (perfil_id) REFERENCES perfiles(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Editoriales de los libros&#10;CREATE TABLE editoriales (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(150) NOT NULL UNIQUE,&#10;    pais                   VARCHAR(60),&#10;    CONSTRAINT pk_editoriales PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Autores&#10;CREATE TABLE autores (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(100) NOT NULL,&#10;    apellidos              VARCHAR(100),&#10;    nacionalidad           VARCHAR(60),&#10;    CONSTRAINT pk_autores PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Temas o categorías del catálogo&#10;CREATE TABLE temas (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(120) NOT NULL UNIQUE,&#10;    descripcion            VARCHAR(255),&#10;    CONSTRAINT pk_temas PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Ficha bibliográfica de cada título&#10;CREATE TABLE libros (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    clave                  VARCHAR(20) NOT NULL UNIQUE,&#10;    isbn                   VARCHAR(20) UNIQUE,&#10;    titulo                 VARCHAR(255) NOT NULL,&#10;    editorial_id           INT UNSIGNED NOT NULL,&#10;    tema_id                INT UNSIGNED NOT NULL,&#10;    anio                   SMALLINT,&#10;    edicion                VARCHAR(30),&#10;    sinopsis               TEXT,&#10;    tipo_acceso            ENUM(&amp;#x27;Circulante&amp;#x27;,&amp;#x27;Reservado&amp;#x27;,&amp;#x27;Consulta externa&amp;#x27;) NOT NULL DEFAULT &amp;#x27;Circulante&amp;#x27;,&#10;    activo                 BOOLEAN NOT NULL DEFAULT TRUE,&#10;    fecha_registro         DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    fecha_baja             DATETIME,&#10;    CONSTRAINT pk_libros PRIMARY KEY (id),&#10;    CONSTRAINT fk_libros_editorial FOREIGN KEY (editorial_id) REFERENCES editoriales(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_libros_tema FOREIGN KEY (tema_id) REFERENCES temas(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Relación N:M entre libros y autores&#10;CREATE TABLE libro_autores (&#10;    libro_id               INT UNSIGNED NOT NULL,&#10;    autor_id               INT UNSIGNED NOT NULL,&#10;    orden                  TINYINT UNSIGNED NOT NULL DEFAULT 1,&#10;    CONSTRAINT pk_libro_autores PRIMARY KEY (libro_id, autor_id),&#10;    CONSTRAINT fk_libro_autores_libro FOREIGN KEY (libro_id) REFERENCES libros(id)&#10;        ON UPDATE CASCADE ON DELETE CASCADE,&#10;    CONSTRAINT fk_libro_autores_autor FOREIGN KEY (autor_id) REFERENCES autores(id)&#10;        ON UPDATE CASCADE ON DELETE CASCADE&#10;) ENGINE=InnoDB;&#10;&#10;-- Salas de la biblioteca (Sala General, Hemeroteca...)&#10;CREATE TABLE estancias (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(60) NOT NULL UNIQUE,&#10;    descripcion            VARCHAR(255),&#10;    CONSTRAINT pk_estancias PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Estantes dentro de cada estancia&#10;CREATE TABLE estantes (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    estancia_id            INT UNSIGNED NOT NULL,&#10;    clave                  VARCHAR(20) NOT NULL,&#10;    CONSTRAINT pk_estantes PRIMARY KEY (id),&#10;    CONSTRAINT uq_estantes_estancia_id_clave UNIQUE (estancia_id, clave),&#10;    CONSTRAINT fk_estantes_estancia FOREIGN KEY (estancia_id) REFERENCES estancias(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&lt;/pre&gt;" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Courier New;fontSize=10;fillColor=#f7f7f7;fontColor=#1a1a1a;strokeColor=#999999;" vertex="1" parent="csq-1"><mxGeometry x="60" y="0" width="900" height="1930" as="geometry" /></mxCell><mxCell id="csq-4" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:10px;line-height:12px&quot;&gt;-- Copias físicas de cada libro, con ubicación y estado&#10;CREATE TABLE ejemplares (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    codigo                 VARCHAR(20) NOT NULL UNIQUE,&#10;    libro_id               INT UNSIGNED NOT NULL,&#10;    estante_id             INT UNSIGNED,&#10;    posicion               VARCHAR(20),&#10;    estado                 ENUM(&amp;#x27;Disponible&amp;#x27;,&amp;#x27;Prestado&amp;#x27;,&amp;#x27;Reservado&amp;#x27;,&amp;#x27;Perdido&amp;#x27;,&amp;#x27;Dañado&amp;#x27;,&amp;#x27;Fuera de servicio&amp;#x27;) NOT NULL DEFAULT &amp;#x27;Disponible&amp;#x27;,&#10;    fecha_alta             DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    fecha_actualizacion    DATETIME,&#10;    CONSTRAINT pk_ejemplares PRIMARY KEY (id),&#10;    CONSTRAINT fk_ejemplares_libro FOREIGN KEY (libro_id) REFERENCES libros(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_ejemplares_estante FOREIGN KEY (estante_id) REFERENCES estantes(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Historial de precios (para calcular reposición por pérdida)&#10;CREATE TABLE precios_libro (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    libro_id               INT UNSIGNED NOT NULL,&#10;    precio                 DECIMAL(10,2) NOT NULL,&#10;    moneda                 ENUM(&amp;#x27;MXN&amp;#x27;,&amp;#x27;USD&amp;#x27;) NOT NULL DEFAULT &amp;#x27;MXN&amp;#x27;,&#10;    fecha_registro         DATE NOT NULL,&#10;    CONSTRAINT pk_precios_libro PRIMARY KEY (id),&#10;    CONSTRAINT ck_precios_libro_1 CHECK (precio &amp;gt; 0),&#10;    CONSTRAINT fk_precios_libro_libro FOREIGN KEY (libro_id) REFERENCES libros(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Tipo de cambio vigente por fecha&#10;CREATE TABLE tipos_cambio (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    moneda                 ENUM(&amp;#x27;USD&amp;#x27;) NOT NULL DEFAULT &amp;#x27;USD&amp;#x27;,&#10;    fecha                  DATE NOT NULL,&#10;    valor_mxn              DECIMAL(10,4) NOT NULL,&#10;    CONSTRAINT pk_tipos_cambio PRIMARY KEY (id),&#10;    CONSTRAINT uq_tipos_cambio_moneda_fecha UNIQUE (moneda, fecha),&#10;    CONSTRAINT ck_tipos_cambio_1 CHECK (valor_mxn &amp;gt; 0)&#10;) ENGINE=InnoDB;&#10;&#10;-- Proveedores de libros&#10;CREATE TABLE proveedores (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    nombre                 VARCHAR(150) NOT NULL,&#10;    rfc                    VARCHAR(13) UNIQUE,&#10;    telefono               VARCHAR(20),&#10;    email                  VARCHAR(150),&#10;    CONSTRAINT pk_proveedores PRIMARY KEY (id)&#10;) ENGINE=InnoDB;&#10;&#10;-- Órdenes de compra generadas por el bibliotecario&#10;CREATE TABLE ordenes_compra (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    folio                  VARCHAR(20) NOT NULL UNIQUE,&#10;    proveedor_id           INT UNSIGNED NOT NULL,&#10;    usuario_id             INT UNSIGNED NOT NULL,&#10;    fecha_requerida        DATE NOT NULL,&#10;    justificacion          TEXT,&#10;    estado                 ENUM(&amp;#x27;Registrada&amp;#x27;,&amp;#x27;Enviada&amp;#x27;,&amp;#x27;Recibida&amp;#x27;,&amp;#x27;Cancelada&amp;#x27;) NOT NULL DEFAULT &amp;#x27;Registrada&amp;#x27;,&#10;    fecha_registro         DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    CONSTRAINT pk_ordenes_compra PRIMARY KEY (id),&#10;    CONSTRAINT fk_ordenes_compra_proveedor FOREIGN KEY (proveedor_id) REFERENCES proveedores(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_ordenes_compra_usuario FOREIGN KEY (usuario_id) REFERENCES usuarios(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Renglones (libros y cantidades) de cada orden&#10;CREATE TABLE orden_items (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    orden_id               INT UNSIGNED NOT NULL,&#10;    libro_id               INT UNSIGNED NOT NULL,&#10;    cantidad               SMALLINT UNSIGNED NOT NULL,&#10;    precio_unitario        DECIMAL(10,2),&#10;    moneda                 ENUM(&amp;#x27;MXN&amp;#x27;,&amp;#x27;USD&amp;#x27;) NOT NULL DEFAULT &amp;#x27;MXN&amp;#x27;,&#10;    cantidad_recibida      SMALLINT UNSIGNED NOT NULL DEFAULT 0,&#10;    CONSTRAINT pk_orden_items PRIMARY KEY (id),&#10;    CONSTRAINT uq_orden_items_orden_id_libro_id UNIQUE (orden_id, libro_id),&#10;    CONSTRAINT ck_orden_items_1 CHECK (cantidad &amp;gt; 0),&#10;    CONSTRAINT fk_orden_items_orden FOREIGN KEY (orden_id) REFERENCES ordenes_compra(id)&#10;        ON UPDATE CASCADE ON DELETE CASCADE,&#10;    CONSTRAINT fk_orden_items_libro FOREIGN KEY (libro_id) REFERENCES libros(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Retiro de ejemplares perdidos, robados, dañados u obsoletos&#10;CREATE TABLE bajas_ejemplar (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    ejemplar_id            INT UNSIGNED NOT NULL UNIQUE,&#10;    usuario_id             INT UNSIGNED NOT NULL,&#10;    motivo                 ENUM(&amp;#x27;Perdido&amp;#x27;,&amp;#x27;Robado&amp;#x27;,&amp;#x27;Dañado&amp;#x27;,&amp;#x27;Obsoleto&amp;#x27;) NOT NULL,&#10;    fecha_baja             DATE NOT NULL,&#10;    observaciones          VARCHAR(255),&#10;    CONSTRAINT pk_bajas_ejemplar PRIMARY KEY (id),&#10;    CONSTRAINT fk_bajas_ejemplar_ejemplar FOREIGN KEY (ejemplar_id) REFERENCES ejemplares(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_bajas_ejemplar_usuario FOREIGN KEY (usuario_id) REFERENCES usuarios(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Préstamo de un ejemplar a un usuario&#10;CREATE TABLE prestamos (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    ejemplar_id            INT UNSIGNED NOT NULL,&#10;    usuario_id             INT UNSIGNED NOT NULL,&#10;    bibliotecario_id       INT UNSIGNED NOT NULL,&#10;    fecha_prestamo         DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    fecha_vencimiento      DATE NOT NULL,&#10;    estado                 ENUM(&amp;#x27;Activo&amp;#x27;,&amp;#x27;Devuelto&amp;#x27;,&amp;#x27;Vencido&amp;#x27;,&amp;#x27;Perdido&amp;#x27;) NOT NULL DEFAULT &amp;#x27;Activo&amp;#x27;,&#10;    CONSTRAINT pk_prestamos PRIMARY KEY (id),&#10;    CONSTRAINT fk_prestamos_ejemplar FOREIGN KEY (ejemplar_id) REFERENCES ejemplares(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_prestamos_usuario FOREIGN KEY (usuario_id) REFERENCES usuarios(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_prestamos_bibliotecario FOREIGN KEY (bibliotecario_id) REFERENCES usuarios(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Historial de renovaciones de cada préstamo&#10;CREATE TABLE renovaciones (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    prestamo_id            INT UNSIGNED NOT NULL,&#10;    numero                 TINYINT UNSIGNED NOT NULL,&#10;    fecha_renovacion       DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    vencimiento_anterior   DATE NOT NULL,&#10;    vencimiento_nuevo      DATE NOT NULL,&#10;    CONSTRAINT pk_renovaciones PRIMARY KEY (id),&#10;    CONSTRAINT uq_renovaciones_prestamo_id_numero UNIQUE (prestamo_id, numero),&#10;    CONSTRAINT fk_renovaciones_prestamo FOREIGN KEY (prestamo_id) REFERENCES prestamos(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&lt;/pre&gt;" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Courier New;fontSize=10;fillColor=#f7f7f7;fontColor=#1a1a1a;strokeColor=#999999;" vertex="1" parent="csq-1"><mxGeometry x="990" y="0" width="900" height="1835" as="geometry" /></mxCell><mxCell id="csq-5" value="&lt;pre style=&quot;margin:0;font-family:Courier New,monospace;font-size:10px;line-height:12px&quot;&gt;-- Registro de la devolución (máximo una por préstamo)&#10;CREATE TABLE devoluciones (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    prestamo_id            INT UNSIGNED NOT NULL UNIQUE,&#10;    bibliotecario_id       INT UNSIGNED NOT NULL,&#10;    fecha_devolucion       DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    condicion              ENUM(&amp;#x27;Bueno&amp;#x27;,&amp;#x27;Dañado&amp;#x27;) NOT NULL DEFAULT &amp;#x27;Bueno&amp;#x27;,&#10;    observaciones          VARCHAR(255),&#10;    CONSTRAINT pk_devoluciones PRIMARY KEY (id),&#10;    CONSTRAINT fk_devoluciones_prestamo FOREIGN KEY (prestamo_id) REFERENCES prestamos(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_devoluciones_bibliotecario FOREIGN KEY (bibliotecario_id) REFERENCES usuarios(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Recibos de préstamo enviados o impresos&#10;CREATE TABLE comprobantes_prestamo (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    prestamo_id            INT UNSIGNED NOT NULL,&#10;    medio                  ENUM(&amp;#x27;Email&amp;#x27;,&amp;#x27;WhatsApp&amp;#x27;,&amp;#x27;Impresión&amp;#x27;) NOT NULL,&#10;    destino                VARCHAR(150),&#10;    fecha_emision          DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    CONSTRAINT pk_comprobantes_prestamo PRIMARY KEY (id),&#10;    CONSTRAINT fk_comprobantes_prestamo_prestamo FOREIGN KEY (prestamo_id) REFERENCES prestamos(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Usuarios esperando un libro sin ejemplares disponibles&#10;CREATE TABLE lista_espera (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    libro_id               INT UNSIGNED NOT NULL,&#10;    usuario_id             INT UNSIGNED NOT NULL,&#10;    fecha_solicitud        DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    estado                 ENUM(&amp;#x27;En espera&amp;#x27;,&amp;#x27;Notificado&amp;#x27;,&amp;#x27;Atendido&amp;#x27;,&amp;#x27;Cancelado&amp;#x27;) NOT NULL DEFAULT &amp;#x27;En espera&amp;#x27;,&#10;    CONSTRAINT pk_lista_espera PRIMARY KEY (id),&#10;    CONSTRAINT fk_lista_espera_libro FOREIGN KEY (libro_id) REFERENCES libros(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_lista_espera_usuario FOREIGN KEY (usuario_id) REFERENCES usuarios(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Avisos de vencimiento, adeudo y lista de espera&#10;CREATE TABLE avisos (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    usuario_id             INT UNSIGNED NOT NULL,&#10;    prestamo_id            INT UNSIGNED,&#10;    tipo                   ENUM(&amp;#x27;Vencimiento&amp;#x27;,&amp;#x27;Adeudo&amp;#x27;,&amp;#x27;Lista de espera&amp;#x27;) NOT NULL,&#10;    medio                  ENUM(&amp;#x27;Email&amp;#x27;,&amp;#x27;WhatsApp&amp;#x27;,&amp;#x27;Sistema&amp;#x27;) NOT NULL,&#10;    mensaje                VARCHAR(500) NOT NULL,&#10;    fecha_envio            DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    CONSTRAINT pk_avisos PRIMARY KEY (id),&#10;    CONSTRAINT fk_avisos_usuario FOREIGN KEY (usuario_id) REFERENCES usuarios(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_avisos_prestamo FOREIGN KEY (prestamo_id) REFERENCES prestamos(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Multas generadas por un préstamo&#10;CREATE TABLE multas (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    prestamo_id            INT UNSIGNED NOT NULL,&#10;    motivo                 ENUM(&amp;#x27;Retraso&amp;#x27;,&amp;#x27;Daño&amp;#x27;,&amp;#x27;Pérdida&amp;#x27;) NOT NULL,&#10;    monto                  DECIMAL(10,2) NOT NULL,&#10;    fecha_generacion       DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    estado                 ENUM(&amp;#x27;Pendiente&amp;#x27;,&amp;#x27;Pagada&amp;#x27;,&amp;#x27;Cancelada&amp;#x27;) NOT NULL DEFAULT &amp;#x27;Pendiente&amp;#x27;,&#10;    CONSTRAINT pk_multas PRIMARY KEY (id),&#10;    CONSTRAINT ck_multas_1 CHECK (monto &amp;gt; 0),&#10;    CONSTRAINT fk_multas_prestamo FOREIGN KEY (prestamo_id) REFERENCES prestamos(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Pagos (totales o parciales) de cada multa&#10;CREATE TABLE pagos_multa (&#10;    id                     INT UNSIGNED NOT NULL AUTO_INCREMENT,&#10;    multa_id               INT UNSIGNED NOT NULL,&#10;    bibliotecario_id       INT UNSIGNED NOT NULL,&#10;    monto                  DECIMAL(10,2) NOT NULL,&#10;    metodo                 ENUM(&amp;#x27;Efectivo&amp;#x27;,&amp;#x27;Tarjeta&amp;#x27;,&amp;#x27;Transferencia&amp;#x27;) NOT NULL,&#10;    referencia             VARCHAR(50),&#10;    fecha_pago             DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,&#10;    CONSTRAINT pk_pagos_multa PRIMARY KEY (id),&#10;    CONSTRAINT ck_pagos_multa_1 CHECK (monto &amp;gt; 0),&#10;    CONSTRAINT fk_pagos_multa_multa FOREIGN KEY (multa_id) REFERENCES multas(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT,&#10;    CONSTRAINT fk_pagos_multa_bibliotecario FOREIGN KEY (bibliotecario_id) REFERENCES usuarios(id)&#10;        ON UPDATE CASCADE ON DELETE RESTRICT&#10;) ENGINE=InnoDB;&#10;&#10;-- Índices para búsquedas del catálogo&#10;CREATE INDEX idx_libros_titulo ON libros (titulo);&#10;CREATE INDEX idx_autores_nombre ON autores (apellidos, nombre);&#10;CREATE INDEX idx_usuarios_nombre ON usuarios (apellido_paterno, nombre);&#10;CREATE INDEX idx_ejemplares_estado ON ejemplares (estado);&#10;CREATE INDEX idx_prestamos_estado ON prestamos (estado, fecha_vencimiento);&#10;CREATE INDEX idx_multas_estado ON multas (estado);&#10;&lt;/pre&gt;" style="rounded=0;whiteSpace=nowrap;html=1;align=left;verticalAlign=top;spacing=10;fontFamily=Courier New;fontSize=10;fillColor=#f7f7f7;fontColor=#1a1a1a;strokeColor=#999999;" vertex="1" parent="csq-1"><mxGeometry x="1920" y="0" width="900" height="1336" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="ser" name="1. ER – Sprint 1"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="ser-0" /><mxCell id="ser-1" parent="ser-0" /><mxCell id="ser-2" value="&lt;b style=&quot;font-size:24px&quot;&gt;Diagrama Entidad–Relación · Primera entrega (Sprint 1)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#555&quot;&gt;Sistema Ducky de Gestión Bibliotecaria · Syntra Technologies (Equipo 1) · Notación pata de gallo (Crow's Foot)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="ser-1"><mxGeometry x="60" y="-110" width="1400" height="70" as="geometry" /></mxCell><mxCell id="ser-3" value="perfiles" style="shape=table;startSize=30;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="ser-1"><mxGeometry x="760" y="40" width="230" height="160" as="geometry" /></mxCell><mxCell id="ser-4" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=1;strokeColor=#cccccc;" vertex="1" parent="ser-3"><mxGeometry x="0" y="30" width="230" height="26" as="geometry" /></mxCell><mxCell id="ser-5" value="PK" style="shape=partialRectangle;conn